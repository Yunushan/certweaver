"""Validate a private POSIX controller destination; never print credential bytes."""

from __future__ import annotations

import argparse
import hashlib
import json
import os
import re
import stat
from contextlib import ExitStack
from pathlib import Path

MAX_BYTES = 1024 * 1024


def require(condition, message):
    if not condition:
        raise ValueError(message)


def destination(value, *, create=False, expected=None):
    require(
        os.name == "posix" and hasattr(os, "O_NOFOLLOW") and hasattr(os, "O_DIRECTORY"),
        "Kubeconfig export requires a POSIX controller filesystem",
    )
    require(
        isinstance(value, str)
        and 1 < len(value) <= 4096
        and value.startswith(("/", "~/"))
        and not value.endswith("/")
        and "//" not in value
        and "\\" not in value
        and "{" not in value
        and "}" not in value
        and all(ord(c) >= 32 and ord(c) != 127 for c in value)
        and not {".", ".."}.intersection(value.split("/")),
        "Select a literal absolute or home-relative kubeconfig file path",
    )
    path = Path(value).expanduser()
    require(path.is_absolute() and len(path.parts) > 1, "Invalid kubeconfig destination")
    require(expected is None or re.fullmatch(r"[a-f0-9]{64}", expected), "Invalid expected digest")
    uid, changed = os.geteuid(), False
    flags = os.O_RDONLY | os.O_DIRECTORY | os.O_NOFOLLOW
    with ExitStack() as stack:
        descriptor = os.open("/", flags)
        stack.callback(os.close, descriptor)
        prefix = Path("/")
        for component in path.parts[1:-1]:
            prefix /= component
            try:
                child = os.open(component, flags, dir_fd=descriptor)
            except FileNotFoundError:
                if not create:
                    require(expected is None, "Exported kubeconfig is missing")
                    return {"destination": str(path), "changed": False, "parentReady": False}
                os.mkdir(component, mode=0o700, dir_fd=descriptor)
                changed = True
                child = os.open(component, flags, dir_fd=descriptor)
            stack.callback(os.close, child)
            info = os.fstat(child)
            sticky_system_tmp = (
                prefix in {Path("/tmp"), Path("/var/tmp")}
                and info.st_uid == 0
                and info.st_mode & stat.S_ISVTX
            )
            require(
                info.st_uid in {0, uid} and (not info.st_mode & 0o022 or sticky_system_tmp),
                "Kubeconfig destination has an untrusted writable ancestor",
            )
            descriptor = child
        parent = os.fstat(descriptor)
        require(
            parent.st_uid == uid and stat.S_IMODE(parent.st_mode) == 0o700,
            "The kubeconfig parent must be owned by the controller user with mode 0700",
        )
        try:
            info = os.stat(path.name, dir_fd=descriptor, follow_symlinks=False)
        except FileNotFoundError:
            require(expected is None, "Exported kubeconfig is missing")
        else:
            require(
                stat.S_ISREG(info.st_mode)
                and info.st_uid == uid
                and info.st_nlink == 1
                and stat.S_IMODE(info.st_mode) == 0o600
                and info.st_size <= MAX_BYTES,
                "Existing kubeconfig must be one owned regular file with mode 0600",
            )
            if expected is not None:
                file_descriptor = os.open(path.name, os.O_RDONLY | os.O_NOFOLLOW, dir_fd=descriptor)
                with os.fdopen(file_descriptor, "rb") as stream:
                    opened = os.fstat(stream.fileno())
                    require(
                        (opened.st_dev, opened.st_ino) == (info.st_dev, info.st_ino),
                        "Kubeconfig changed during verification",
                    )
                    payload = stream.read(MAX_BYTES + 1)
                require(
                    0 < len(payload) <= MAX_BYTES
                    and hashlib.sha256(payload).hexdigest() == expected,
                    "Exported kubeconfig bytes differ from the inspected source",
                )
    return {"destination": str(path), "changed": changed, "parentReady": True}


def main(argv=None):
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("operation", choices=["check", "prepare", "verify"])
    parser.add_argument("path")
    parser.add_argument("--sha256")
    args = parser.parse_args(argv)
    try:
        require((args.operation == "verify") == (args.sha256 is not None), "Digest usage mismatch")
        result = destination(args.path, create=args.operation == "prepare", expected=args.sha256)
        print(json.dumps(result))
        return 0
    except (OSError, ValueError, TypeError):
        print("ERROR: private kubeconfig destination rejected")
        return 1


if __name__ == "__main__":
    raise SystemExit(main())
