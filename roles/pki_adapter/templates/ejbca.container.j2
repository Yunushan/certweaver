[Unit]
Description=CertWeaver EJBCA Community
After=network-online.target
Wants=network-online.target

[Container]
Image=docker.io/keyfactor/ejbca-ce@{{ certweaver_adapter_versions.ejbca_image | lower }}
ContainerName=certweaver-ejbca
PublishPort={{ certweaver_adapter_options.get('ejbca-community', {}).get('httpsPort', 8443) }}:8443
EnvironmentFile={{ certweaver_adapter_options.get('ejbca-community', {}).get('environmentFile', '/etc/certweaver/secrets/ejbca.env') }}
Volume=/var/lib/ejbca:/mnt/persistent:Z

[Service]
Restart=always
TimeoutStartSec=600

[Install]
WantedBy=multi-user.target default.target
