[Unit]
Description=CertWeaver Lemur web application
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=lemur
Group=lemur
WorkingDirectory={{ certweaver_lemur_release }}/source
ExecStart={{ certweaver_lemur_release }}/venv/bin/lemur --config=/etc/certweaver/lemur/config.py start -b {{ certweaver_lemur_options.get('bind', '127.0.0.1:8000') }}
Environment=HOME=/var/lib/certweaver-lemur
StateDirectory=certweaver-lemur
StateDirectoryMode=0700
UMask=0077
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
ProtectSystem=full
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
