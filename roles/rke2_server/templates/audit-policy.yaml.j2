apiVersion: audit.k8s.io/v1
kind: Policy
omitStages:
  - RequestReceived
rules:
  - level: Metadata
    resources:
      - group: ""
        resources: ["secrets", "configmaps"]
  - level: RequestResponse
    resources:
      - group: cert-manager.io
      - group: acme.cert-manager.io
      - group: policy.cert-manager.io
      - group: trust.cert-manager.io
  - level: Metadata
