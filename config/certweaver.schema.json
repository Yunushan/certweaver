{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://certweaver.io/schemas/v1alpha1/deployment.json",
  "title": "CertWeaver deployment",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "apiVersion",
    "kind",
    "metadata",
    "spec"
  ],
  "properties": {
    "apiVersion": {
      "const": "certweaver.io/v1alpha1"
    },
    "kind": {
      "const": "CertWeaverDeployment"
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]{1,61}[a-z0-9]$"
        },
        "labels": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      }
    },
    "spec": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "mode",
        "environment",
        "platform",
        "versions",
        "secrets",
        "addons",
        "adapters"
      ],
      "properties": {
        "mode": {
          "enum": [
            "rke2-ha",
            "k3s-ha",
            "existing-kubernetes",
            "standalone",
            "docker",
            "raw",
            "windows"
          ]
        },
        "environment": {
          "enum": [
            "production",
            "staging",
            "development",
            "lab"
          ]
        },
        "platform": {
          "type": "object",
          "required": [
            "nodes"
          ],
          "properties": {
            "os": {
              "type": "string"
            },
            "nodes": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "name",
                  "address"
                ],
                "properties": {
                  "name": {
                    "type": "string"
                  },
                  "address": {
                    "type": "string"
                  },
                  "sshUser": {
                    "type": "string"
                  },
                  "sshPort": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 65535
                  },
                  "interface": {
                    "type": "string"
                  },
                  "keepalivedPriority": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 254
                  },
                  "connection": {
                    "type": "string"
                  },
                  "winrmPort": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 65535
                  },
                  "winrmTransport": {
                    "type": "string"
                  },
                  "winrmServerCertValidation": {
                    "enum": [
                      "validate",
                      "ignore"
                    ]
                  },
                  "ansibleUser": {
                    "type": "string"
                  }
                }
              }
            },
            "vip": {
              "type": "object",
              "properties": {
                "address": {
                  "type": "string"
                },
                "dnsName": {
                  "type": "string"
                },
                "interface": {
                  "type": "string"
                },
                "ports": {
                  "type": "object",
                  "properties": {
                    "api": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 65535
                    },
                    "registration": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 65535
                    },
                    "http": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 65535
                    },
                    "https": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 65535
                    }
                  },
                  "additionalProperties": false
                },
                "prefixLength": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 32
                }
              },
              "additionalProperties": false
            },
            "existingKubeconfig": {
              "type": "string"
            },
            "network": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "manageFirewalld": {
                  "type": "boolean"
                },
                "managementCidrs": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  },
                  "uniqueItems": true
                },
                "ingressCidrs": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  },
                  "uniqueItems": true
                }
              }
            },
            "loadBalancer": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "enabled": {
                  "type": "boolean"
                },
                "provider": {
                  "enum": [
                    "haproxy-keepalived",
                    "external"
                  ]
                },
                "colocated": {
                  "type": "boolean"
                },
                "virtualRouterId": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 255
                },
                "ingressNodePorts": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "http": {
                      "type": "integer",
                      "minimum": 30000,
                      "maximum": 32767
                    },
                    "https": {
                      "type": "integer",
                      "minimum": 30000,
                      "maximum": 32767
                    }
                  }
                }
              }
            },
            "fetchKubeconfig": {
              "type": "boolean"
            }
          }
        },
        "versions": {
          "type": "object",
          "additionalProperties": {
            "type": [
              "string",
              "number",
              "object"
            ]
          },
          "properties": {
            "helmChecksums": {
              "type": "object",
              "additionalProperties": {
                "type": "string",
                "pattern": "^sha256:[a-fA-F0-9]{64}$"
              }
            }
          }
        },
        "secrets": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "rke2TokenFile": {
              "type": "string"
            },
            "keepalivedAuthFile": {
              "type": "string"
            }
          }
        },
        "addons": {
          "type": "object"
        },
        "adapters": {
          "type": "object",
          "required": [
            "enabled"
          ],
          "properties": {
            "enabled": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "uniqueItems": true
            },
            "acknowledge": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "uniqueItems": true
            },
            "options": {
              "type": "object"
            },
            "versions": {
              "type": "object",
              "additionalProperties": {
                "type": "string"
              }
            },
            "checksums": {
              "type": "object",
              "additionalProperties": {
                "type": "string"
              }
            },
            "installMode": {
              "enum": [
                "auto",
                "kubernetes",
                "standalone",
                "docker",
                "raw",
                "windows"
              ]
            },
            "startServices": {
              "type": "boolean"
            }
          }
        },
        "rke2": {
          "type": "object",
          "additionalProperties": true
        },
        "k3s": {
          "type": "object",
          "additionalProperties": true
        }
      }
    }
  }
}
